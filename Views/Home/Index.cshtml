@{
    ViewData["Title"] = "Placement Portal";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3 fw-semibold">
                Apex Institute of Engineering & Technology
            </div>
            <h1 class="display-5 fw-bold text-dark mb-3">Campus Placement & Career Portal</h1>
            <p class="lead text-muted mb-4">
                Streamlining campus recruitments, corporate drives, candidate evaluation, and career opportunities.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom btn-lg px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Portal
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-person-plus me-1"></i> Student Registration
                </a>
            </div>
        </div>
    </div>
</div>
