@model List<StudentPlacementManagement.Models.Notification>
@{
    ViewData["Title"] = "Notification Center";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Notification Center</h2>
            <p class="text-muted small mb-0">Live campus recruitment alerts, application updates, and interview schedules</p>
        </div>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-check2-all me-1"></i> Mark All as Read
                </button>
            </form>
        }
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title">
                        <i class="bi bi-bell-fill text-primary"></i> All Alerts (@Model.Count)
                    </h5>
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@unreadCount Unread</span>
                    }
                </div>
                <div class="modern-card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var note in Model)
                            {
                                <div class="list-group-item p-3 @(!note.IsRead ? "bg-light bg-opacity-75" : "")">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div class="d-flex gap-3">
                                            <div class="pt-1">
                                                @if (note.Type == "Placement")
                                                {
                                                    <span class="p-2 rounded-circle bg-success-subtle text-success d-inline-flex">
                                                        <i class="bi bi-trophy-fill fs-5"></i>
                                                    </span>
                                                }
                                                else if (note.Type == "Interview")
                                                {
                                                    <span class="p-2 rounded-circle bg-info-subtle text-info d-inline-flex">
                                                        <i class="bi bi-calendar-check-fill fs-5"></i>
                                                    </span>
                                                }
                                                else if (note.Type == "Application")
                                                {
                                                    <span class="p-2 rounded-circle bg-primary-subtle text-primary d-inline-flex">
                                                        <i class="bi bi-send-check-fill fs-5"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="p-2 rounded-circle bg-secondary-subtle text-secondary d-inline-flex">
                                                        <i class="bi bi-bell-fill fs-5"></i>
                                                    </span>
                                                }
                                            </div>
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <h6 class="fw-bold text-dark mb-0 fs-6">@note.Title</h6>
                                                    @if (!note.IsRead)
                                                    {
                                                        <span class="badge bg-primary" style="font-size: 0.65rem;">NEW</span>
                                                    }
                                                </div>
                                                <p class="text-muted small mb-1">@note.Message</p>
                                                <small class="text-muted">
                                                    <i class="bi bi-clock me-1"></i>@note.CreatedAt.ToString("dd MMM yyyy, hh:mm tt") UTC
                                                </small>
                                            </div>
                                        </div>

                                        @if (!note.IsRead)
                                        {
                                            <form asp-action="MarkRead" asp-route-id="@note.NotificationId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-link text-decoration-none text-muted" title="Mark as Read">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-bell-slash fs-1 text-muted d-block mb-2"></i>
                            You have no notifications at this time.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
