@model StudentPlacementManagement.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Placement Reports & Analytics";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Campus Placement Reports & Analytics</h2>
            <p class="text-muted small mb-0">Auditable reports, department statistics, recruiter performance, and verified CSV data exports</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportPlacementsCsv" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Placements (CSV)
            </a>
            <a asp-action="ExportStudentsCsv" class="btn btn-outline-primary">
                <i class="bi bi-people me-1"></i> Export All Students (CSV)
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="modern-card mb-4">
        <div class="modern-card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <select name="departmentId" class="form-select">
                        <option value="">-- All Departments --</option>
                        @if (Model.DepartmentOptions != null)
                        {
                            foreach (var dept in Model.DepartmentOptions)
                            {
                                <option value="@dept.Value" selected="@(Model.SelectedDepartmentId?.ToString() == dept.Value)">@dept.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="passingYear" class="form-select">
                        <option value="">-- All Graduating Batches --</option>
                        @if (Model.PassingYearOptions != null)
                        {
                            foreach (var yr in Model.PassingYearOptions)
                            {
                                <option value="@yr.Value" selected="@(Model.SelectedPassingYear?.ToString() == yr.Value)">Batch @yr.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary-custom w-100">Apply Filter</button>
                </div>
                <div class="col-12 col-md-2">
                    <a asp-action="Index" class="btn btn-light border w-100"><i class="bi bi-arrow-counterclockwise me-1"></i>Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Overall KPI Summary Row -->
    @if (Model.OverallReport != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">Placement Percentage</span>
                        <div class="stat-icon stat-icon-emerald"><i class="bi bi-pie-chart-fill"></i></div>
                    </div>
                    <div class="stat-value">@Model.OverallReport.PlacementPercentage%</div>
                    <div class="stat-subtext">@Model.OverallReport.PlacedStudents of @Model.OverallReport.TotalStudents students</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">Highest Package</span>
                        <div class="stat-icon stat-icon-indigo"><i class="bi bi-currency-rupee"></i></div>
                    </div>
                    <div class="stat-value">₹@Model.OverallReport.HighestPackage.ToString("F1") LPA</div>
                    <div class="stat-subtext">Top offer secured</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">Average Package</span>
                        <div class="stat-icon stat-icon-sky"><i class="bi bi-calculator"></i></div>
                    </div>
                    <div class="stat-value">₹@Model.OverallReport.AveragePackage.ToString("F1") LPA</div>
                    <div class="stat-subtext">Campus-wide mean CTC</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">Total Job Offers</span>
                        <div class="stat-icon stat-icon-amber"><i class="bi bi-trophy-fill"></i></div>
                    </div>
                    <div class="stat-value">@Model.OverallReport.TotalOffers</div>
                    <div class="stat-subtext">From @Model.OverallReport.TotalCompanies companies</div>
                </div>
            </div>
        </div>
    }

    <!-- Tabbed Detailed Reports -->
    <div class="modern-card">
        <div class="modern-card-header p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2" id="reportTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="dept-tab" data-bs-toggle="tab" data-bs-target="#dept-pane" type="button">
                        <i class="bi bi-diagram-3 me-1"></i> Department-Wise Report
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="comp-tab" data-bs-toggle="tab" data-bs-target="#comp-pane" type="button">
                        <i class="bi bi-buildings me-1"></i> Company-Wise Report
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="placed-tab" data-bs-toggle="tab" data-bs-target="#placed-pane" type="button">
                        <i class="bi bi-person-check me-1"></i> Selected Students (@Model.SelectedStudents.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="unplaced-tab" data-bs-toggle="tab" data-bs-target="#unplaced-pane" type="button">
                        <i class="bi bi-person-exclamation me-1"></i> Unplaced Students (@Model.UnplacedStudents.Count)
                    </button>
                </li>
            </ul>
        </div>
        <div class="modern-card-body p-0">
            <div class="tab-content" id="reportTabsContent">
                <!-- 1. Department Wise -->
                <div class="tab-pane fade show active" id="dept-pane">
                    <div class="table-responsive">
                        <table class="table modern-table mb-0">
                            <thead>
                                <tr>
                                    <th>Department Name</th>
                                    <th>Total Students</th>
                                    <th>Placed Students</th>
                                    <th>Placement %</th>
                                    <th>Highest Package</th>
                                    <th>Average Package</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.DepartmentReports)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@d.DepartmentName</td>
                                        <td>@d.TotalStudents</td>
                                        <td class="text-success fw-bold">@d.PlacedStudents</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fw-semibold">@d.PlacementPercentage%</span>
                                                <div class="progress custom-progress flex-grow-1" style="max-width: 80px;">
                                                    <div class="progress-bar custom-progress-bar" style="width: @d.PlacementPercentage%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>₹@d.HighestPackage.ToString("F2") LPA</td>
                                        <td>₹@d.AveragePackage.ToString("F2") LPA</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 2. Company Wise -->
                <div class="tab-pane fade" id="comp-pane">
                    <div class="table-responsive">
                        <table class="table modern-table mb-0">
                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>Industry</th>
                                    <th>Drives Held</th>
                                    <th>Total Applications</th>
                                    <th>Selections / Offers</th>
                                    <th>Max Package</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CompanyReports)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@c.CompanyName</td>
                                        <td><span class="badge bg-light text-dark border">@c.Industry</span></td>
                                        <td>@c.DrivesConducted</td>
                                        <td>@c.TotalApplications</td>
                                        <td class="text-success fw-bold">@c.SelectedCandidates</td>
                                        <td>₹@c.MaxPackageOffered.ToString("F2") LPA</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 3. Selected Students -->
                <div class="tab-pane fade" id="placed-pane">
                    <div class="table-responsive">
                        <table class="table modern-table mb-0">
                            <thead>
                                <tr>
                                    <th>Roll No & Student</th>
                                    <th>Department</th>
                                    <th>Placed Company</th>
                                    <th>Job Designation</th>
                                    <th>Package</th>
                                    <th>Offer Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.SelectedStudents)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@p.Student?.FullName</div>
                                            <small class="text-muted">@p.Student?.EnrollmentNo</small>
                                        </td>
                                        <td>@p.Student?.Department?.DepartmentCode</td>
                                        <td class="fw-semibold text-dark">@p.Company?.CompanyName</td>
                                        <td>@p.JobRole</td>
                                        <td><span class="badge bg-success-subtle text-success fw-bold">₹@p.SalaryPackage.ToString("F2") LPA</span></td>
                                        <td>@p.PlacementDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4. Unplaced Students -->
                <div class="tab-pane fade" id="unplaced-pane">
                    <div class="table-responsive">
                        <table class="table modern-table mb-0">
                            <thead>
                                <tr>
                                    <th>Roll No & Student</th>
                                    <th>Department</th>
                                    <th>Graduation Year</th>
                                    <th>CGPA</th>
                                    <th>Backlogs</th>
                                    <th>Resume Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.UnplacedStudents)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@s.FullName</div>
                                            <small class="text-muted">@s.EnrollmentNo &bull; @s.Email</small>
                                        </td>
                                        <td>@s.Department?.DepartmentCode</td>
                                        <td>@s.PassingYear</td>
                                        <td class="fw-bold text-dark">@s.CGPA.ToString("F2")</td>
                                        <td>@s.Backlogs</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(s.ResumePath))
                                            {
                                                <span class="badge bg-success-subtle text-success">Verified</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
