@model StudentPlacementManagement.Models.Company
@{
    ViewData["Title"] = Model.CompanyName;
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">@Model.CompanyName</h2>
            <p class="text-muted small mb-0">@(Model.Industry ?? "Recruiting Partner") &bull; @(Model.Location ?? "Multiple Locations")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> All Companies
            </a>
            @if (isAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.CompanyId" class="btn btn-primary-custom">
                    <i class="bi bi-pencil me-1"></i> Edit Company
                </a>
            }
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Left Column: Company Overview & HR Contact -->
        <div class="col-12 col-lg-4">
            <div class="modern-card mb-4">
                <div class="modern-card-header">
                    <h5 class="modern-card-title"><i class="bi bi-info-circle text-primary"></i> Company Overview</h5>
                </div>
                <div class="modern-card-body">
                    <div class="text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.LogoPath))
                        {
                            <img src="@Model.LogoPath" alt="@Model.CompanyName" class="rounded-3 border p-1 mb-2" style="max-height: 80px; max-width: 160px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="stat-icon stat-icon-indigo mx-auto mb-2" style="width: 64px; height: 64px; font-size: 2rem;">
                                <i class="bi bi-buildings"></i>
                            </div>
                        }
                        <h5 class="fw-bold text-dark mb-0">@Model.CompanyName</h5>
                        <div class="text-muted small">@Model.Industry</div>
                    </div>

                    <p class="text-muted small">
                        @(Model.Description ?? "Partner employer participating in campus recruitment drives.")
                    </p>

                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <div class="mb-2 small">
                            <span class="text-muted d-block">Official Website:</span>
                            <a href="@Model.Website" target="_blank" class="text-primary text-decoration-none fw-semibold">
                                <i class="bi bi-globe me-1"></i>@Model.Website
                            </a>
                        </div>
                    }

                    <div class="border-top pt-3 mt-3">
                        <h6 class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">HR & Recruitment Contact</h6>
                        <div class="small text-muted py-1"><strong>Name:</strong> @(Model.HRName ?? "Campus Hiring Team")</div>
                        <div class="small text-muted py-1"><strong>Email:</strong> @(Model.HREmail ?? "recruiting@company.com")</div>
                        <div class="small text-muted py-1"><strong>Phone:</strong> @(Model.HRPhone ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Drives and Placements -->
        <div class="col-12 col-lg-8">
            <!-- Placement Drives Conducted -->
            <div class="modern-card mb-4">
                <div class="modern-card-header">
                    <h5 class="modern-card-title">
                        <i class="bi bi-briefcase text-primary"></i> Placement Drives Conducted (@Model.PlacementDrives.Count)
                    </h5>
                    @if (isAdmin)
                    {
                        <a asp-controller="PlacementDrive" asp-action="Create" class="btn btn-sm btn-primary">New Drive</a>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table modern-table mb-0">
                        <thead>
                            <tr>
                                <th>Role</th>
                                <th>Package</th>
                                <th>Eligible Branches</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PlacementDrives.Any())
                            {
                                foreach (var drive in Model.PlacementDrives)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@drive.JobRole</div>
                                            <small class="text-muted">Drive Date: @drive.DriveDate.ToString("dd MMM yyyy")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">₹@drive.SalaryPackage.ToString("F2") LPA</span>
                                        </td>
                                        <td>
                                            @foreach (var dd in drive.DriveDepartments)
                                            {
                                                <span class="badge bg-primary-subtle text-primary small me-1">@dd.Department?.DepartmentCode</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="status-badge status-@(drive.Status.ToLower())">@drive.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="PlacementDrive" asp-action="Details" asp-route-id="@drive.DriveId" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No placement drives announced yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Placed Students from this Company -->
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title">
                        <i class="bi bi-patch-check-fill text-success"></i> Hired Students (@Model.Placements.Count)
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table modern-table mb-0">
                        <thead>
                            <tr>
                                <th>Candidate</th>
                                <th>Department</th>
                                <th>Role & Package</th>
                                <th>Offer Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Placements.Any())
                            {
                                foreach (var p in Model.Placements)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@p.Student?.FullName</div>
                                            <small class="text-muted">@p.Student?.EnrollmentNo</small>
                                        </td>
                                        <td>@p.Student?.Department?.DepartmentCode</td>
                                        <td>
                                            <div class="fw-semibold text-dark">@p.JobRole</div>
                                            <span class="badge bg-success-subtle text-success">₹@p.SalaryPackage.ToString("F2") LPA</span>
                                        </td>
                                        <td>@p.PlacementDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No candidate offers recorded yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
