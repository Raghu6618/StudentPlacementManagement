@model List<StudentPlacementManagement.Models.Company>
@{
    ViewData["Title"] = "Recruiting Companies";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Corporate Partners & Recruiting Companies</h2>
            <p class="text-muted small mb-0">Explore industry recruiters, campus placement partnerships, and company profiles</p>
        </div>
        @if (isAdmin)
        {
            <div>
                <a asp-action="Create" class="btn btn-primary-custom">
                    <i class="bi bi-plus-circle me-1"></i> Register Company
                </a>
            </div>
        }
    </div>

    <!-- Search & Filter Bar -->
    <div class="modern-card mb-4">
        <div class="modern-card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search by company name, location, domain..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <select name="industry" class="form-select">
                        <option value="">-- All Industries / Domains --</option>
                        @foreach (var ind in (List<string>)ViewBag.Industries)
                        {
                            <option value="@ind" selected="@(ViewBag.Industry == ind)">@ind</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-primary-custom w-100">Filter</button>
                    <a asp-action="Index" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Companies Cards Grid -->
    <div class="row g-3 mb-4">
        @if (Model.Any())
        {
            foreach (var c in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="modern-card h-100 d-flex flex-column">
                        <div class="modern-card-body flex-grow-1">
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(c.LogoPath))
                                    {
                                        <img src="@c.LogoPath" alt="@c.CompanyName" class="company-logo-img" />
                                    }
                                    else
                                    {
                                        <div class="stat-icon stat-icon-indigo" style="width: 44px; height: 44px;">
                                            <i class="bi bi-buildings"></i>
                                        </div>
                                    }
                                    <div>
                                        <h5 class="fw-bold text-dark mb-0 fs-6">@c.CompanyName</h5>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.72rem;">@(c.Industry ?? "Technology")</span>
                                    </div>
                                </div>
                                @if (c.IsActive)
                                {
                                    <span class="status-badge status-open">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge status-closed">Inactive</span>
                                }
                            </div>

                            <p class="text-muted small mb-3 text-truncate-2" style="min-height: 2.4rem;">
                                @(string.IsNullOrEmpty(c.Description) ? "Corporate recruiting partner conducting on-campus recruitment drives." : c.Description)
                            </p>

                            <div class="border-top pt-2 mt-auto small">
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-geo-alt me-1"></i>Location:</span>
                                    <strong class="text-dark">@(c.Location ?? "Multiple")</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-briefcase me-1"></i>Drives Held:</span>
                                    <strong class="text-primary">@c.PlacementDrives.Count</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-trophy me-1"></i>Offers Given:</span>
                                    <strong class="text-success">@c.Placements.Count</strong>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@c.CompanyId" class="btn btn-sm btn-outline-primary fw-semibold">
                                View Profile <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                            @if (isAdmin)
                            {
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@c.CompanyId" class="btn btn-light border" title="Edit Company">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-light border @(c.IsActive ? "text-warning" : "text-success")" title="@(c.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(c.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-buildings fs-1 text-muted d-block mb-2"></i>
                <h5 class="text-muted">No recruiting companies found</h5>
                <p class="small text-muted">Try adjusting your search criteria or register a new company.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="p-3 modern-card d-flex justify-content-between align-items-center">
            <div class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</div>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = p, search = ViewBag.Search, industry = ViewBag.Industry })">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
