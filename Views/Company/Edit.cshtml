@model StudentPlacementManagement.Models.Company
@{
    ViewData["Title"] = "Edit Company";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title">
                        <i class="bi bi-pencil-square text-primary"></i> Edit Company: @Model.CompanyName
                    </h5>
                    <a asp-action="Details" asp-route-id="@Model.CompanyId" class="btn btn-sm btn-outline-secondary">Back to Details</a>
                </div>
                <div class="modern-card-body">
                    <form asp-action="Edit" asp-route-id="@Model.CompanyId" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="LogoPath" />

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Company Information</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-7">
                                <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name <span class="text-danger">*</span></label>
                                <input asp-for="CompanyName" class="form-control" required />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Industry" class="form-label fw-semibold small">Industry / Domain</label>
                                <input asp-for="Industry" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Website" class="form-label fw-semibold small">Website URL</label>
                                <input asp-for="Website" type="url" class="form-control" />
                                <span asp-validation-for="Website" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label fw-semibold small">Primary Hiring Location</label>
                                <input asp-for="Location" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold small">Description</label>
                                <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Change Logo (Optional)</label>
                                <input type="file" name="logoFile" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.svg,.webp" />
                            </div>
                            <div class="col-12 form-check ms-3">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold small">Company is actively hiring on campus</label>
                            </div>
                        </div>

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 pt-2">HR Contact Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="HRName" class="form-label fw-semibold small">HR Name</label>
                                <input asp-for="HRName" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HREmail" class="form-label fw-semibold small">HR Email</label>
                                <input asp-for="HREmail" type="email" class="form-control" />
                                <span asp-validation-for="HREmail" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HRPhone" class="form-label fw-semibold small">HR Phone</label>
                                <input asp-for="HRPhone" class="form-control" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.CompanyId" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary-custom">Update Company</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
