@model StudentPlacementManagement.Models.Company
@{
    ViewData["Title"] = "Add Recruiting Company";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title">
                        <i class="bi bi-buildings-fill text-primary"></i> Register Partner Company
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Directory</a>
                </div>
                <div class="modern-card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                            <div asp-validation-summary="All" class="mb-0"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Company Details</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-7">
                                <label asp-for="CompanyName" class="form-label fw-semibold small">Company Name <span class="text-danger">*</span></label>
                                <input asp-for="CompanyName" class="form-control" placeholder="e.g. Google India" required />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Industry" class="form-label fw-semibold small">Industry / Domain</label>
                                <input asp-for="Industry" class="form-control" placeholder="e.g. Software, Fintech, Core" />
                                <span asp-validation-for="Industry" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Website" class="form-label fw-semibold small">Website URL</label>
                                <input asp-for="Website" type="url" class="form-control" placeholder="https://www.example.com" />
                                <span asp-validation-for="Website" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label fw-semibold small">Primary Hiring Location</label>
                                <input asp-for="Location" class="form-control" placeholder="e.g. Bengaluru, Hyderabad" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold small">About the Company</label>
                                <textarea asp-for="Description" rows="3" class="form-control" placeholder="Brief description of the organization, culture, and projects..."></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small">Company Logo (Optional)</label>
                                <input type="file" name="logoFile" class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.svg,.webp" />
                                <small class="text-muted">PNG, JPG or SVG formats</small>
                            </div>
                        </div>

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3 pt-2">HR & Placement Coordinator Contact</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="HRName" class="form-label fw-semibold small">HR Contact Person</label>
                                <input asp-for="HRName" class="form-control" placeholder="e.g. Sarah Connor" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HREmail" class="form-label fw-semibold small">HR Official Email</label>
                                <input asp-for="HREmail" type="email" class="form-control" placeholder="campus@company.com" />
                                <span asp-validation-for="HREmail" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HRPhone" class="form-label fw-semibold small">HR Phone Number</label>
                                <input asp-for="HRPhone" class="form-control" placeholder="+91 98765 00000" />
                                <span asp-validation-for="HRPhone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary-custom">
                                <i class="bi bi-check-circle me-1"></i> Register Company
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
