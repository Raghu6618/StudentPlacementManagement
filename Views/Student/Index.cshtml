@model List<StudentPlacementManagement.Models.Student>
@{
    ViewData["Title"] = "Students Directory";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Students Directory</h2>
            <p class="text-muted small mb-0">Manage registered students, track academic standings, and verify resumes</p>
        </div>
        <div>
            <span class="badge bg-primary fs-6 px-3 py-2">
                <i class="bi bi-people-fill me-1"></i> Total Registered: @ViewBag.TotalCount
            </span>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="modern-card mb-4">
        <div class="modern-card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search by name, roll no, email..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="departmentId" class="form-select">
                        <option value="">-- All Departments --</option>
                        @foreach (var dept in (IEnumerable<SelectListItem>)ViewBag.Departments)
                        {
                            <option value="@dept.Value" selected="@(ViewBag.DepartmentId?.ToString() == dept.Value)">@dept.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="placementStatus" class="form-select">
                        <option value="">-- All Placement Statuses --</option>
                        <option value="Placed" selected="@(ViewBag.PlacementStatus == "Placed")">Placed</option>
                        <option value="NotPlaced" selected="@(ViewBag.PlacementStatus == "NotPlaced")">Not Placed</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary-custom w-100">Filter</button>
                    <a asp-action="Index" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Students Table -->
    <div class="modern-card">
        <div class="table-responsive">
            <table class="table modern-table mb-0">
                <thead>
                    <tr>
                        <th>Roll No & Name</th>
                        <th>Department</th>
                        <th>Batch</th>
                        <th>CGPA / Backlogs</th>
                        <th>Resume</th>
                        <th>Placement Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@s.FullName</div>
                                    <small class="text-muted">@s.EnrollmentNo &bull; @s.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@s.Department?.DepartmentCode</span>
                                    <small class="d-block text-muted" style="font-size: 0.75rem;">@s.Department?.DepartmentName</small>
                                </td>
                                <td>@s.PassingYear</td>
                                <td>
                                    <strong>@s.CGPA.ToString("F2")</strong>
                                    <small class="d-block text-muted">@s.Backlogs backlog(s)</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(s.ResumePath))
                                    {
                                        <a asp-action="DownloadResume" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-danger py-0 px-2" target="_blank">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>Resume
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not Uploaded</span>
                                    }
                                </td>
                                <td>
                                    @if (s.PlacementStatus == "Placed")
                                    {
                                        <span class="status-badge status-placed"><i class="bi bi-check2"></i> Placed</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-notplaced">Not Placed</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Profile" asp-route-id="@s.StudentId" class="btn btn-outline-primary" title="View Profile">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="EditProfile" asp-route-id="@s.StudentId" class="btn btn-outline-secondary" title="Edit Student">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-people fs-1 text-secondary d-block mb-2"></i>
                                No student records found matching the specified filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                    Page @ViewBag.CurrentPage of @ViewBag.TotalPages
                </div>
                <ul class="pagination pagination-sm mb-0">
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = p, search = ViewBag.Search, departmentId = ViewBag.DepartmentId, placementStatus = ViewBag.PlacementStatus })">@p</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
