@model List<StudentPlacementManagement.Models.PlacementDrive>
@{
    ViewData["Title"] = "Placement Drives";
    var isAdmin = User.IsInRole("Admin");
    var isStudent = User.IsInRole("Student");
    var eligibilityMap = ViewBag.StudentEligibilityMap as Dictionary<int, StudentPlacementManagement.Services.Interfaces.EligibilityResult>;
    var appliedDriveIds = ViewBag.AppliedDriveIds as List<int> ?? new List<int>();
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Campus Placement Drives</h2>
            <p class="text-muted small mb-0">Browse company hiring opportunities, job descriptions, eligibility criteria, and application deadlines</p>
        </div>
        @if (isAdmin)
        {
            <div>
                <a asp-action="Create" class="btn btn-primary-custom">
                    <i class="bi bi-plus-circle me-1"></i> New Placement Drive
                </a>
            </div>
        }
    </div>

    <!-- Filter & Search Bar -->
    <div class="modern-card mb-4">
        <div class="modern-card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search by role, company, skills..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select name="status" class="form-select">
                        <option value="">-- All Statuses --</option>
                        <option value="Open" selected="@(ViewBag.Status == "Open")">Open (Accepting Applications)</option>
                        <option value="Upcoming" selected="@(ViewBag.Status == "Upcoming")">Upcoming</option>
                        <option value="Closed" selected="@(ViewBag.Status == "Closed")">Closed</option>
                        <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="departmentId" class="form-select">
                        <option value="">-- All Departments --</option>
                        @foreach (var dept in (IEnumerable<SelectListItem>)ViewBag.Departments)
                        {
                            <option value="@dept.Value" selected="@(ViewBag.DepartmentId?.ToString() == dept.Value)">@dept.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary-custom w-100">Filter</button>
                    <a asp-action="Index" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Drives Grid -->
    <div class="row g-3 mb-4">
        @if (Model.Any())
        {
            foreach (var drive in Model)
            {
                var isApplied = appliedDriveIds.Contains(drive.DriveId);
                var elig = eligibilityMap != null && eligibilityMap.ContainsKey(drive.DriveId) ? eligibilityMap[drive.DriveId] : null;

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="modern-card h-100 d-flex flex-column">
                        <div class="modern-card-body flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="status-badge status-@(drive.Status.ToLower()) mb-1">@drive.Status</span>
                                    <h5 class="fw-bold text-dark mb-0 fs-6">@drive.JobRole</h5>
                                    <span class="text-primary fw-semibold small">@drive.Company?.CompanyName</span>
                                </div>
                                <span class="badge bg-success-subtle text-success fs-6 fw-bold">
                                    ₹@drive.SalaryPackage.ToString("F2") LPA
                                </span>
                            </div>

                            <p class="text-muted small mb-3 text-truncate-2" style="min-height: 2.4rem;">
                                @drive.JobDescription
                            </p>

                            <!-- Criteria Pills -->
                            <div class="bg-light p-2 rounded-3 mb-3 small">
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-award me-1"></i>Min CGPA:</span>
                                    <strong class="text-dark">@drive.MinCGPA.ToString("F2")</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-shield-slash me-1"></i>Max Backlogs:</span>
                                    <strong class="text-dark">@drive.MaxBacklogs</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-geo-alt me-1"></i>Location:</span>
                                    <strong class="text-dark">@(drive.JobLocation ?? "Multiple")</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 text-muted">
                                    <span><i class="bi bi-calendar-event me-1"></i>Drive Date:</span>
                                    <strong class="text-dark">@drive.DriveDate.ToString("dd MMM yyyy")</strong>
                                </div>
                            </div>

                            <!-- Eligible Branches -->
                            <div class="mb-2">
                                <span class="text-muted small d-block mb-1" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;">Eligible Branches:</span>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var dd in drive.DriveDepartments)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 0.72rem;">@dd.Department?.DepartmentCode</span>
                                    }
                                </div>
                            </div>

                            <!-- If student is viewing, show their personalized eligibility pill -->
                            @if (isStudent && elig != null)
                            {
                                <div class="mt-3 pt-2 border-top">
                                    @if (isApplied)
                                    {
                                        <div class="badge bg-info-subtle text-info d-block py-2 text-start">
                                            <i class="bi bi-check2-all me-1"></i> You have applied to this drive
                                        </div>
                                    }
                                    else if (elig.IsEligible)
                                    {
                                        <div class="badge bg-success-subtle text-success d-block py-2 text-start">
                                            <i class="bi bi-check-circle-fill me-1"></i> You are eligible to apply
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="badge bg-danger-subtle text-danger d-block py-2 text-start text-truncate" title="@elig.Reason">
                                            <i class="bi bi-x-circle-fill me-1"></i> @elig.Reason
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Card Footer -->
                        <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted">
                                <i class="bi bi-people me-1"></i>@drive.Applications.Count applicants
                            </span>
                            <a asp-action="Details" asp-route-id="@drive.DriveId" class="btn btn-sm btn-primary fw-semibold px-3">
                                View Details &bull; Apply
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-briefcase fs-1 text-muted d-block mb-2"></i>
                <h5 class="text-muted">No placement drives found</h5>
                <p class="small text-muted">Check back later or adjust your filter selection.</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="p-3 modern-card d-flex justify-content-between align-items-center">
            <div class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</div>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= ViewBag.TotalPages; p++)
                {
                    <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = p, status = ViewBag.Status, departmentId = ViewBag.DepartmentId, search = ViewBag.Search })">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
