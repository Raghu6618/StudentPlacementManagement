@model StudentPlacementManagement.ViewModels.PlacementDriveCreateViewModel
@{
    ViewData["Title"] = "Create Placement Drive";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Create Placement Drive</h2>
            <p class="text-muted small mb-0">Publish a new campus recruitment drive with eligibility criteria and target departments</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Drives
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title"><i class="bi bi-briefcase-fill text-primary"></i> Placement Drive Definition</h5>
                </div>
                <div class="modern-card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show small" role="alert">
                            <div asp-validation-summary="All" class="mb-0"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Section 1: Company & Role Details -->
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Company & Job Role</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="CompanyId" class="form-label small fw-semibold">Hiring Partner / Company <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-select" asp-items="Model.CompanyList" required>
                                    <option value="">-- Select Company --</option>
                                </select>
                                <span asp-validation-for="CompanyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JobRole" class="form-label small fw-semibold">Job Role / Designation <span class="text-danger">*</span></label>
                                <input asp-for="JobRole" class="form-control" placeholder="e.g. Graduate Software Engineer" required />
                                <span asp-validation-for="JobRole" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SalaryPackage" class="form-label small fw-semibold">Salary Package (CTC in ₹ LPA) <span class="text-danger">*</span></label>
                                <input asp-for="SalaryPackage" type="number" step="0.01" min="0.1" class="form-control" placeholder="e.g. 8.50" required />
                                <span asp-validation-for="SalaryPackage" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EmploymentType" class="form-label small fw-semibold">Employment Type</label>
                                <select asp-for="EmploymentType" class="form-select">
                                    <option value="Full Time">Full Time</option>
                                    <option value="Internship + PPO">Internship + PPO</option>
                                    <option value="Internship">Internship Only</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="JobLocation" class="form-label small fw-semibold">Job Location</label>
                                <input asp-for="JobLocation" class="form-control" placeholder="e.g. Bengaluru, Pune, Remote" />
                            </div>
                            <div class="col-12">
                                <label asp-for="JobDescription" class="form-label small fw-semibold">Job Description & Responsibilities <span class="text-danger">*</span></label>
                                <textarea asp-for="JobDescription" rows="4" class="form-control" placeholder="Detailed role description, team overview, technologies used..." required></textarea>
                                <span asp-validation-for="JobDescription" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="RequiredSkills" class="form-label small fw-semibold">Key Technical Skills (Comma separated)</label>
                                <input asp-for="RequiredSkills" class="form-control" placeholder="e.g. C#, ASP.NET Core, SQL Server, Problem Solving, Git" />
                            </div>
                        </div>

                        <!-- Section 2: Eligibility Rules -->
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Eligibility Engine Rules</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="MinCGPA" class="form-label small fw-semibold">Minimum CGPA Required <span class="text-danger">*</span></label>
                                <input asp-for="MinCGPA" type="number" step="0.01" min="0" max="10" class="form-control" required />
                                <span asp-validation-for="MinCGPA" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxBacklogs" class="form-label small fw-semibold">Max Active Backlogs Allowed <span class="text-danger">*</span></label>
                                <input asp-for="MaxBacklogs" type="number" min="0" class="form-control" required />
                                <span asp-validation-for="MaxBacklogs" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PassingYear" class="form-label small fw-semibold">Graduating Batch / Year <span class="text-danger">*</span></label>
                                <input asp-for="PassingYear" type="number" class="form-control" required />
                                <span asp-validation-for="PassingYear" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Eligible Academic Departments <span class="text-danger">*</span></label>
                                <div class="row g-2 p-3 bg-light rounded-3 border">
                                    @if (Model.DepartmentList != null)
                                    {
                                        foreach (var dept in Model.DepartmentList)
                                        {
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="SelectedDepartmentIds" value="@dept.Value" id="dept_@dept.Value" @(Model.SelectedDepartmentIds.Contains(int.Parse(dept.Value)) ? "checked" : "")>
                                                    <label class="form-check-label small" for="dept_@dept.Value">
                                                        @dept.Text
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                <span asp-validation-for="SelectedDepartmentIds" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="EligibilityDescription" class="form-label small fw-semibold">Special Eligibility Notes</label>
                                <input asp-for="EligibilityDescription" class="form-control" placeholder="e.g. Only candidates with >70% in 10th & 12th standard" />
                            </div>
                        </div>

                        <!-- Section 3: Timeline & Dates -->
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Application Window & Drive Date</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="ApplicationStartDate" class="form-label small fw-semibold">Application Start Date & Time <span class="text-danger">*</span></label>
                                <input asp-for="ApplicationStartDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="ApplicationStartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ApplicationEndDate" class="form-label small fw-semibold">Application Deadline <span class="text-danger">*</span></label>
                                <input asp-for="ApplicationEndDate" type="datetime-local" class="form-control" required />
                                <span asp-validation-for="ApplicationEndDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DriveDate" class="form-label small fw-semibold">Drive Execution Date <span class="text-danger">*</span></label>
                                <input asp-for="DriveDate" type="date" class="form-control" required />
                                <span asp-validation-for="DriveDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label small fw-semibold">Initial Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="Upcoming">Upcoming</option>
                                    <option value="Closed">Closed</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary-custom px-4">
                                <i class="bi bi-check2-circle me-1"></i> Save & Publish Drive
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
