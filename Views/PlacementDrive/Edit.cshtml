@model StudentPlacementManagement.ViewModels.PlacementDriveCreateViewModel
@{
    ViewData["Title"] = "Edit Placement Drive";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Edit Placement Drive</h2>
            <p class="text-muted small mb-0">Modify drive details, package, deadlines, or eligible departments</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.DriveId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Details
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title"><i class="bi bi-pencil-square text-primary"></i> Update Drive: @Model.JobRole</h5>
                </div>
                <div class="modern-card-body">
                    <form asp-action="Edit" asp-route-id="@Model.DriveId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DriveId" />

                        <!-- Section 1: Company & Role Details -->
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Company & Job Role</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="CompanyId" class="form-label small fw-semibold">Company <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-select" asp-items="Model.CompanyList" required></select>
                                <span asp-validation-for="CompanyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JobRole" class="form-label small fw-semibold">Job Role <span class="text-danger">*</span></label>
                                <input asp-for="JobRole" class="form-control" required />
                                <span asp-validation-for="JobRole" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SalaryPackage" class="form-label small fw-semibold">Salary Package (LPA) <span class="text-danger">*</span></label>
                                <input asp-for="SalaryPackage" type="number" step="0.01" min="0.1" class="form-control" required />
                                <span asp-validation-for="SalaryPackage" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="EmploymentType" class="form-label small fw-semibold">Employment Type</label>
                                <select asp-for="EmploymentType" class="form-select">
                                    <option value="Full Time">Full Time</option>
                                    <option value="Internship + PPO">Internship + PPO</option>
                                    <option value="Internship">Internship Only</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="JobLocation" class="form-label small fw-semibold">Job Location</label>
                                <input asp-for="JobLocation" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="JobDescription" class="form-label small fw-semibold">Job Description <span class="text-danger">*</span></label>
                                <textarea asp-for="JobDescription" rows="4" class="form-control" required></textarea>
                            </div>
                            <div class="col-12">
                                <label asp-for="RequiredSkills" class="form-label small fw-semibold">Required Skills</label>
                                <input asp-for="RequiredSkills" class="form-control" />
                            </div>
                        </div>

                        <!-- Section 2: Eligibility Rules -->
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">2. Eligibility Engine Criteria</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="MinCGPA" class="form-label small fw-semibold">Min CGPA <span class="text-danger">*</span></label>
                                <input asp-for="MinCGPA" type="number" step="0.01" min="0" max="10" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MaxBacklogs" class="form-label small fw-semibold">Max Backlogs <span class="text-danger">*</span></label>
                                <input asp-for="MaxBacklogs" type="number" min="0" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PassingYear" class="form-label small fw-semibold">Graduating Batch <span class="text-danger">*</span></label>
                                <input asp-for="PassingYear" type="number" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Eligible Departments <span class="text-danger">*</span></label>
                                <div class="row g-2 p-3 bg-light rounded-3 border">
                                    @if (Model.DepartmentList != null)
                                    {
                                        foreach (var dept in Model.DepartmentList)
                                        {
                                            <div class="col-md-4">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="SelectedDepartmentIds" value="@dept.Value" id="dept_edit_@dept.Value" @(Model.SelectedDepartmentIds.Contains(int.Parse(dept.Value)) ? "checked" : "")>
                                                    <label class="form-check-label small" for="dept_edit_@dept.Value">
                                                        @dept.Text
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <label asp-for="EligibilityDescription" class="form-label small fw-semibold">Eligibility Notes</label>
                                <input asp-for="EligibilityDescription" class="form-control" />
                            </div>
                        </div>

                        <!-- Section 3: Dates & Status -->
                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">3. Schedule & Status</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label asp-for="ApplicationStartDate" class="form-label small fw-semibold">Start Date <span class="text-danger">*</span></label>
                                <input asp-for="ApplicationStartDate" type="datetime-local" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="ApplicationEndDate" class="form-label small fw-semibold">End Date <span class="text-danger">*</span></label>
                                <input asp-for="ApplicationEndDate" type="datetime-local" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="DriveDate" class="form-label small fw-semibold">Drive Date <span class="text-danger">*</span></label>
                                <input asp-for="DriveDate" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Status" class="form-label small fw-semibold">Drive Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="Upcoming">Upcoming</option>
                                    <option value="Closed">Closed</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@Model.DriveId" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary-custom px-4">Update Drive</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
