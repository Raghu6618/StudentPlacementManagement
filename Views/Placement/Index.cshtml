@model List<StudentPlacementManagement.Models.Placement>
@{
    ViewData["Title"] = "Campus Placements";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Final Placements & Job Offers</h2>
            <p class="text-muted small mb-0">Record of all confirmed campus placements, offer letters, and student joining status</p>
        </div>
        <div>
            <a asp-controller="Report" asp-action="ExportPlacementsCsv" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-arrow-down me-1"></i> Export Placements (CSV)
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="modern-card mb-4">
        <div class="modern-card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="Search candidate, company, role..." value="@ViewBag.Search" />
                </div>
                <div class="col-6 col-md-3">
                    <select name="companyId" class="form-select">
                        <option value="">-- All Companies --</option>
                        @foreach (var c in (IEnumerable<SelectListItem>)ViewBag.Companies)
                        {
                            <option value="@c.Value" selected="@(ViewBag.CompanyId?.ToString() == c.Value)">@c.Text</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select name="departmentId" class="form-select">
                        <option value="">-- All Departments --</option>
                        @foreach (var dept in (IEnumerable<SelectListItem>)ViewBag.Departments)
                        {
                            <option value="@dept.Value" selected="@(ViewBag.DepartmentId?.ToString() == dept.Value)">@dept.Text</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary-custom w-100">Filter</button>
                    <a asp-action="Index" class="btn btn-light border" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Placements Table -->
    <div class="modern-card">
        <div class="table-responsive">
            <table class="table modern-table mb-0">
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Department</th>
                        <th>Placed Company & Role</th>
                        <th>Annual Package</th>
                        <th>Placement Date</th>
                        <th>Joining Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@p.Student?.FullName</div>
                                    <small class="text-muted">@p.Student?.EnrollmentNo &bull; @p.Student?.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@p.Student?.Department?.DepartmentCode</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@p.Company?.CompanyName</div>
                                    <small class="text-muted">@p.JobRole</small>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success fs-6 fw-bold">₹@p.SalaryPackage.ToString("F2") LPA</span>
                                </td>
                                <td>
                                    <small class="text-muted">@p.PlacementDate.ToString("dd MMM yyyy")</small>
                                </td>
                                <td>
                                    <span class="status-badge status-@(p.Status.ToLower())">@p.Status</span>
                                    @if (p.JoiningDate.HasValue)
                                    {
                                        <small class="d-block text-muted">Joining: @p.JoiningDate.Value.ToString("dd MMM yyyy")</small>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@p.PlacementId" class="btn btn-sm btn-outline-primary">
                                        Details / Update
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-trophy fs-1 text-muted d-block mb-2"></i>
                                No placement records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <div class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</div>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search, companyId = ViewBag.CompanyId, departmentId = ViewBag.DepartmentId })">@i</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
