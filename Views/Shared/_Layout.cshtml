@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Placement Cell Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
        var userInitial = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "U";
        var isAdmin = User.IsInRole("Admin");
        var isStudent = User.IsInRole("Student");

        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar">
                <div class="sidebar-header">
                    <a href="@(isAdmin ? Url.Action("Dashboard", "Admin") : Url.Action("Dashboard", "Student"))" class="sidebar-brand">
                        <div class="brand-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div>
                            <div style="font-size: 1.05rem; line-height: 1.2;">PlacementHub</div>
                            <small style="font-size: 0.68rem; color: #94a3b8; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em;">Campus Career Cell</small>
                        </div>
                    </a>
                </div>

                <ul class="sidebar-menu">
                    @if (isAdmin)
                    {
                        <li class="menu-category">Main</li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        <li class="menu-category">Management</li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Student" asp-action="Index">
                                <i class="bi bi-people-fill"></i>
                                <span>Students Directory</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")" asp-controller="Department" asp-action="Index">
                                <i class="bi bi-diagram-3-fill"></i>
                                <span>Departments</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Company" ? "active" : "")" asp-controller="Company" asp-action="Index">
                                <i class="bi bi-buildings-fill"></i>
                                <span>Companies</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PlacementDrive" ? "active" : "")" asp-controller="PlacementDrive" asp-action="Index">
                                <i class="bi bi-briefcase-fill"></i>
                                <span>Placement Drives</span>
                            </a>
                        </li>

                        <li class="menu-category">Recruitment</li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Application" ? "active" : "")" asp-controller="Application" asp-action="Index">
                                <i class="bi bi-file-earmark-person-fill"></i>
                                <span>Applications</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Placement" ? "active" : "")" asp-controller="Placement" asp-action="Index">
                                <i class="bi bi-patch-check-fill"></i>
                                <span>Placements</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                                <i class="bi bi-bar-chart-line-fill"></i>
                                <span>Analytics & Reports</span>
                            </a>
                        </li>

                        <li class="menu-category">System</li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "active" : "")" asp-controller="Notification" asp-action="Index">
                                <i class="bi bi-bell-fill"></i>
                                <span>Notifications</span>
                            </a>
                        </li>
                    }
                    else if (isStudent)
                    {
                        <li class="menu-category">Student Portal</li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Student" asp-action="Dashboard">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "active" : "")" asp-controller="Student" asp-action="Profile">
                                <i class="bi bi-person-badge-fill"></i>
                                <span>My Profile & Resume</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PlacementDrive" ? "active" : "")" asp-controller="PlacementDrive" asp-action="Index">
                                <i class="bi bi-briefcase-fill"></i>
                                <span>Placement Drives</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Application" ? "active" : "")" asp-controller="Application" asp-action="MyApplications">
                                <i class="bi bi-send-check-fill"></i>
                                <span>My Applications</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Interview" ? "active" : "")" asp-controller="Interview" asp-action="MyInterviews">
                                <i class="bi bi-calendar-event-fill"></i>
                                <span>Interview Schedule</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Placement" ? "active" : "")" asp-controller="Placement" asp-action="MyOffer">
                                <i class="bi bi-trophy-fill"></i>
                                <span>My Placement Offer</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Company" ? "active" : "")" asp-controller="Company" asp-action="Index">
                                <i class="bi bi-buildings-fill"></i>
                                <span>Companies</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notification" ? "active" : "")" asp-controller="Notification" asp-action="Index">
                                <i class="bi bi-bell-fill"></i>
                                <span>Notifications</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-footer">
                    <div class="user-profile-badge">
                        <div class="user-avatar-circle">
                            @userInitial
                        </div>
                        <div class="overflow-hidden">
                            <div class="text-white text-truncate fw-semibold" style="font-size: 0.85rem;">
                                @displayName
                            </div>
                            <span class="badge bg-primary text-uppercase" style="font-size: 0.65rem;">
                                @(isAdmin ? "Placement Officer" : "Student")
                            </span>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- Main Panel -->
            <div class="app-main">
                <!-- Topbar -->
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button id="sidebarToggle" class="btn btn-light d-lg-none" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <div class="d-none d-md-block">
                            <span class="fw-bold text-dark" style="letter-spacing: -0.01em;">Apex Institute of Engineering & Technology</span>
                            <span class="text-muted mx-2">|</span>
                            <span class="text-muted small">Campus Placement Portal</span>
                        </div>
                    </div>

                    <div class="topbar-right">
                        <!-- Notifications -->
                        <a asp-controller="Notification" asp-action="Index" class="notification-bell-btn" title="View Notifications">
                            <i class="bi bi-bell fs-5"></i>
                            <span id="unreadNotificationBadge" class="notification-pill" style="display: none;">0</span>
                        </a>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 text-primary"></i>
                                <span class="d-none d-sm-inline fw-semibold small">@displayName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                @if (isStudent)
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Student" asp-action="Profile"><i class="bi bi-person-gear me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Application" asp-action="MyApplications"><i class="bi bi-file-text me-2"></i>My Applications</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Alerts Banner -->
                <div class="px-4 pt-3 pb-0">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 border-0" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 border-0" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["WarningMessage"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show shadow-sm d-flex align-items-center gap-2 border-0" role="alert">
                            <i class="bi bi-exclamation-circle-fill fs-5 text-warning"></i>
                            <div>@TempData["WarningMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>

                <!-- Main Dynamic Content -->
                <main class="app-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Minimal Guest / Auth Layout -->
        <div class="min-vh-100 d-flex flex-column bg-light">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 px-4 shadow-sm">
                <div class="container-fluid">
                    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
                        <i class="bi bi-mortarboard-fill text-primary fs-4"></i>
                        <span>Student Placement Management System</span>
                    </a>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm px-3">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3">Student Register</a>
                    </div>
                </div>
            </nav>

            <div class="flex-grow-1 d-flex align-items-center justify-content-center p-3">
                @RenderBody()
            </div>

            <footer class="text-center py-3 text-muted small border-top bg-white">
                &copy; @DateTime.UtcNow.Year Apex Institute of Engineering & Technology. All Rights Reserved.
            </footer>
        </div>
    }

    <!-- jQuery (required for client validation and DOM scripts) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom site scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
