@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0 p-5 rounded-4">
                <div class="mb-4">
                    <span class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-exclamation-octagon fs-1"></i>
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-2">An unexpected error occurred</h2>
                <p class="text-muted mb-4">
                    An issue occurred while processing your request. The technical team has been notified. Please try again or return to the main dashboard.
                </p>

                @if (Model?.ShowRequestId ?? false)
                {
                    <div class="p-3 bg-light rounded-3 small text-muted mb-4 font-monospace">
                        Request ID: <code>@Model.RequestId</code>
                    </div>
                }

                <div>
                    <a href="/" class="btn btn-primary px-4 py-2 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Back to Safety
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
