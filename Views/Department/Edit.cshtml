@model StudentPlacementManagement.Models.Department
@{
    ViewData["Title"] = "Edit Department";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="modern-card">
                <div class="modern-card-header">
                    <h5 class="modern-card-title">
                        <i class="bi bi-pencil text-primary"></i> Edit Department
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
                </div>
                <div class="modern-card-body">
                    <form asp-action="Edit" asp-route-id="@Model.DepartmentId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DepartmentId" />
                        <input type="hidden" asp-for="CreatedAt" />

                        <div class="mb-3">
                            <label asp-for="DepartmentName" class="form-label fw-semibold small">Department Name <span class="text-danger">*</span></label>
                            <input asp-for="DepartmentName" class="form-control" required />
                            <span asp-validation-for="DepartmentName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DepartmentCode" class="form-label fw-semibold small">Department Code / Acronym <span class="text-danger">*</span></label>
                            <input asp-for="DepartmentCode" class="form-control" required />
                            <span asp-validation-for="DepartmentCode" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light">Cancel</a>
                            <button type="submit" class="btn btn-primary-custom">Update Department</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
