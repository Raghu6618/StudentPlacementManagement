@model List<StudentPlacementManagement.Models.Department>
@{
    ViewData["Title"] = "Academic Departments";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Departments / Academic Branches</h2>
            <p class="text-muted small mb-0">Manage university academic branches and track department placement ratios</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle me-1"></i> Add Department
            </a>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var dept in Model)
        {
            var studentCount = dept.Students.Count;
            var placedCount = dept.Students.Count(s => s.PlacementStatus == "Placed");
            var pct = studentCount > 0 ? Math.Round(((decimal)placedCount / studentCount) * 100, 1) : 0m;

            <div class="col-12 col-md-6 col-xl-4">
                <div class="modern-card h-100">
                    <div class="modern-card-header">
                        <div>
                            <span class="badge bg-primary-subtle text-primary fw-bold">@dept.DepartmentCode</span>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light border-0" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <a asp-action="Edit" asp-route-id="@dept.DepartmentId" class="dropdown-item">
                                        <i class="bi bi-pencil me-2"></i>Edit
                                    </a>
                                </li>
                                <li>
                                    <form asp-action="Delete" asp-route-id="@dept.DepartmentId" method="post" onsubmit="return confirm('Are you sure you want to delete this department?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-trash me-2"></i>Delete
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="modern-card-body">
                        <h5 class="fw-bold text-dark mb-3">@dept.DepartmentName</h5>
                        <div class="d-flex justify-content-between align-items-center mb-2 small">
                            <span class="text-muted">Registered Students:</span>
                            <strong class="text-dark">@studentCount</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 small">
                            <span class="text-muted">Students Placed:</span>
                            <strong class="text-success">@placedCount</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3 small">
                            <span class="text-muted">Placement Rate:</span>
                            <strong class="text-primary">@pct%</strong>
                        </div>
                        <div class="progress custom-progress">
                            <div class="progress-bar custom-progress-bar" style="width: @pct%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
